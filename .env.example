# GlassBox environment - PLACEHOLDERS ONLY. Copy to .env and fill from the
# team vault. .env is gitignored; never commit real values anywhere.
#
# Variable names align with Alpaca's official MCP server (alpaca-mcp-server),
# which expects ALPACA_SECRET_KEY. The old name ALPACA_API_SECRET is retired;
# if any code still reads it, fix the code, not this file.

# --- Alpaca (dev paper account now; competition account keys ~Sep 1) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# --- LLM (per-pod; each side bills its own account) ---
ANTHROPIC_API_KEY=

# --- Ops ---
# Order id prefix for this box: tkc- (teakeycee side) or jho- (Jhoosier side)
ORDER_ID_PREFIX=
